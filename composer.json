{
  "name": "adeguntoro/j2fakit",
  "description": "2FA gate package: by default every route requires login+2FA, whitelist via config/path/exempt.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "adeguntoro"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "laravel/jetstream": "^5.0",
    "laravel/fortify": "^1.20",
    "livewire/livewire": "^3.0",
    "bacon/bacon-qr-code": "^3.0",
    "pragmarx/google2fa": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Adeguntoro\\J2FAKit\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Adeguntoro\\J2FAKit\\J2FAKitServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Adeguntoro\\J2FAKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
